---
import "../styles/global.css";
import { SITE_DESC, SITE_NAME, SITE_URL } from "../config";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  type?: "website" | "article";
  publishedTime?: string;
  sourceLink?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESC,
  canonical,
  type = "website",
  publishedTime,
  sourceLink,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonicalUrl = canonical
  ? new URL(canonical, SITE_URL).href
  : new URL(Astro.url.pathname, SITE_URL).href;
const shortDescription =
  description.length > 155
    ? `${description.slice(0, 152).trimEnd()}…`
    : description;
const jsonLd =
  type === "article" && publishedTime
    ? {
        "@context": "https://schema.org",
        "@type": "NewsArticle",
        headline: title ?? SITE_NAME,
        datePublished: publishedTime,
        inLanguage: "id",
        mainEntityOfPage: canonicalUrl,
        publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
        ...(sourceLink ? { isBasedOn: sourceLink } : {}),
      }
    : undefined;
const jsonLdText = jsonLd
  ? JSON.stringify(jsonLd).replace(/</g, "\\u003c")
  : undefined;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const homeActive = path === "/";
const aboutActive = path === "/tentang";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f5f7fa" />
    <link rel="icon" href="/favicon.svg" sizes="any" />
    <title>{pageTitle}</title>
    <meta name="description" content={shortDescription} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={shortDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={shortDescription} />
    {
      type === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");
          const systemDark = matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.dataset.theme =
            saved === "light" || saved === "dark"
              ? saved
              : systemDark
                ? "dark"
                : "light";
        } catch {
          document.documentElement.dataset.theme = matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches
            ? "dark"
            : "light";
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Lewati ke konten</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label={`${SITE_NAME}, beranda`}
          ><img
            class="brand-icon"
            src="/favicon.ico"
            alt=""
            width="28"
            height="28"
          />{SITE_NAME}</a
        >
        <nav class="site-nav" aria-label="Navigasi utama">
          <a href="/" aria-current={homeActive ? "page" : undefined}>Beranda</a>
          <a href="/tentang" aria-current={aboutActive ? "page" : undefined}
            >Tentang</a
          >
          <button
            class="theme-toggle"
            type="button"
            aria-label="Ganti tema"
            title="Ganti tema"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><circle cx="12" cy="12" r="4"></circle><path
                d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"
              ></path></svg
            >
          </button>
        </nav>
      </div>
    </header>
    <main id="main-content" class="page-shell"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <a class="brand" href="/" aria-label={`${SITE_NAME}, beranda`}
          ><img
            class="brand-icon"
            src="/favicon.ico"
            alt=""
            width="28"
            height="28"
          />{SITE_NAME}</a
        >
        <nav class="footer-links" aria-label="Navigasi footer">
          <a href="/tentang">Tentang</a>
          <a href="/privasi">Privasi</a>
          <a href="/kontak">Kontak</a>
        </nav>
        <p class="footer-note">
          Sebagian artikel disusun dengan bantuan AI. Tautan sumber dicantumkan
          pada setiap artikel.
        </p>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const button = document.querySelector(".theme-toggle");
        button?.addEventListener("click", () => {
          const next =
            document.documentElement.dataset.theme === "dark"
              ? "light"
              : "dark";
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem("theme", next);
          } catch {
            /* Storage may be unavailable. */
          }
        });
      })();
    </script>
  </body>
</html>
